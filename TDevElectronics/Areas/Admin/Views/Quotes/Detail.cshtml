@model SampleQuote
@{
    ViewData["Title"] = "Quote " + Model.Id;
    ViewBag.Page = "a-quo";
    string status = ViewBag.Status;
}
<section class="pg ad"><div class="ab">
<p class="cr m"><a asp-action="Index">Quote Requests</a> / @Model.Id</p>
<h1>Báo giá @Model.Id <span class="tg">@status</span></h1>
@if (TempData["Success"] != null) { <div class="cd" style="border-left:4px solid #10b981;margin-bottom:16px">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="cd" style="border-left:4px solid #ef4444;margin-bottom:16px;color:#ef4444">@TempData["Error"]</div> }

<div class="lay2">
  <div class="cd">
    <h3>@Model.Project</h3>
    <p>@Model.Company · @Model.Contact<br><span class="m">Gửi ngày @Model.Date.ToString("dd MMM yyyy")</span></p>
    <p>@Model.Notes</p>
    <p class="sl"><b>Trước thuế</b><b class="tot">@SampleData.Money(Model.Amount)</b></p>
  </div>
  <div class="cd">
    <h3>Cập nhật trạng thái</h3>
    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
        <select name="status">
            @foreach (var s in SampleAdminData.QuoteStatuses) { <option value="@s" selected="@(s == status)">@s</option> }
        </select>
        <button class="bt" type="submit">Lưu</button>
    </form>
  </div>
</div></div></section>
