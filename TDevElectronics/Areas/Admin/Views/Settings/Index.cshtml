@{
    ViewData["Title"] = "Settings";
    ViewBag.Page = "a-set";
}

@* Chuyển từ template 32-a-set.html. Bảng và bộ lọc do app.js dựng ở trình duyệt (giai đoạn 1). *@
<section class="pg ad" id="a-set"><div class="ab"><h1>Website and console settings</h1><p class="m">Changes to the website apply to every visitor straight away.</p><div id="ahb"></div><div id="ahp"></div><div class="cd sg" id="edit-pages"><div class="hx"><div><h3>Edit pages</h3><p class="m">Edit the text and pictures of the storefront pages right here, without leaving the admin console. Saved changes apply to every visitor.</p></div></div><div class="ept" id="ep-tabs" role="tablist" aria-label="Page to edit" data-notr></div><div class="epf"><iframe id="ep-fr" title="Page editor" data-notr></iframe></div><p class="m"><small>Click any text to edit it, use “Change image” on pictures and “Add content block” for new sections. Use the panel inside the preview to save.</small></p></div><div id="acb"></div><div id="as"></div></div></section>

