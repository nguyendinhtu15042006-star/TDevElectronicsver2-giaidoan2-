@* Phân trang dùng chung. Model: (int Current, int Total, string Action) *@
@model (int Current, int Total, string Action)
@if (Model.Total > 1)
{
    <div class="pgn">
        <span class="m">Trang @Model.Current / @Model.Total</span>
        <div>
            @if (Model.Current > 1) { <a asp-action="@Model.Action" asp-route-page="@(Model.Current - 1)">‹</a> }
            @for (var i = 1; i <= Model.Total; i++)
            {
                <a class="@(i == Model.Current ? "on" : "")" asp-action="@Model.Action" asp-route-page="@i">@i</a>
            }
            @if (Model.Current < Model.Total) { <a asp-action="@Model.Action" asp-route-page="@(Model.Current + 1)">›</a> }
        </div>
    </div>
}
