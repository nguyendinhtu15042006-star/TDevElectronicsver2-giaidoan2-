@model AccountViewModel
@{
    ViewData["Title"] = "My account";
    ViewBag.Page = "account";
}

@* Chuyển từ template 10-account.html. Bảng và bộ lọc do app.js dựng ở trình duyệt (giai đoạn 1). *@
<section class="pg " id="account"><p class="cr m">Home &nbsp;/&nbsp; My account</p><h1>Hey @Model.FirstName, welcome back.</h1><p class="m">Your tech, orders and team purchases. All in one happy place.</p><div class="lay3">
<aside class="cd side"><span class="av">@Model.Initials</span><h3>@Model.FullName</h3><p class="m">@Model.Company</p><hr><a class="on" href="/Account" data-view="overview">Overview</a><a class="" href="/Account" data-view="orders">Orders</a><a class="" href="/Account" data-view="wishlist">Wishlist</a><a class="" href="/Quotes">My Quotes</a><a class="" href="/Account" data-view="profile">Profile &amp; addresses</a><a class="" href="/Account/Login">Sign out</a></aside><div><div class="cd hx" data-v="overview profile"><div><h3>@Model.Company</h3><p class="m">@Model.FullName@(string.IsNullOrWhiteSpace(Model.JobTitle) ? "" : " · " + Model.JobTitle)<br>@Model.Email</p></div><div><span class="tg">Verified business</span> <a class="bo">Edit profile</a></div></div>
<div class="g3 stt" data-v="overview"><div class="cd"><span class="si"><svg class="i"><use href="#i-box"/></svg></span><small class="m">Orders this year</small><h2>12</h2><small class="gr">Your latest order is processing</small></div><div class="cd"><span class="si"><svg class="i"><use href="#i-heart"/></svg></span><small class="m">Saved favorites</small><h2>3</h2><small class="gr">Ready when you are</small></div><div class="cd"><span class="si"><svg class="i"><use href="#i-file"/></svg></span><small class="m">Open quotes</small><h2>2</h2><small class="gr">1 quote ready to review</small></div></div>
<h2 data-v="overview orders">Your recent orders</h2><div class="tw" data-v="overview orders"><table><tr><th>Order</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th>Action</th></tr><tr class="hl"><td><b>TD-1048</b></td><td>08 Oct 2026</td><td>3 items</td><td>$1,541.16</td><td><span class="tg b">Processing</span></td><td>View</td></tr><tr><td><b>TD-1047</b></td><td>02 Oct 2026</td><td>12 items</td><td>$3,240.00</td><td><span class="tg ">Delivered</span></td><td>View</td></tr><tr><td><b>TD-1036</b></td><td>18 Sep 2026</td><td>8 items</td><td>$1,944.00</td><td><span class="tg ">Delivered</span></td><td>View</td></tr><tr><td><b>TD-1021</b></td><td>06 Sep 2026</td><td>20 items</td><td>$5,076.00</td><td><span class="tg ">Delivered</span></td><td>View</td></tr></table></div><div class="pgn" data-v="overview orders"><span class="m">Showing 4 recent orders</span><div><a>‹</a><a class="on">1</a><a>2</a><a>3</a><a>…</a><a>›</a></div></div>
<h2 data-v="orders">Payment history</h2><div class="tw" data-v="orders"><table id="txt"><tr><th>Transaction</th><th>Order</th><th>Date</th><th>Method</th><th>Amount</th><th>Status</th></tr><tr><td><b>TXN-10485521</b></td><td>TD-1048</td><td>08 Oct 2026</td><td>Visa •••• 4242</td><td>$1,541.16</td><td><span class="tg ">Paid</span></td></tr><tr><td><b>TXN-10473304</b></td><td>TD-1047</td><td>02 Oct 2026</td><td>Visa •••• 4242</td><td>$3,240.00</td><td><span class="tg ">Paid</span></td></tr><tr><td><b>TXN-10368127</b></td><td>TD-1036</td><td>18 Sep 2026</td><td>Bank transfer</td><td>$1,944.00</td><td><span class="tg ">Paid</span></td></tr><tr><td><b>TXN-10216690</b></td><td>TD-1021</td><td>06 Sep 2026</td><td>Net 30 invoice</td><td>$5,076.00</td><td><span class="tg ">Paid</span></td></tr></table></div><h2 data-v="overview wishlist">Saved for a little later</h2><div class="g3" data-v="overview wishlist"><div class="pc" data-k="phone"><a class="ph phone" href="/Shop"><svg class="i hr"><use href="#i-heart"/></svg></a><small class="br">SAMSUNG</small><b>Galaxy S25</b><p class="sp">256GB · 5G · Icy blue<br><span class="st">★</span> 4.8 (174)</p><h3 class="pr">$799.00</h3><span class="tg">In stock</span><a class="bx" href="/Shop">Add to Cart</a></div><div class="pc" data-k="airpods"><a class="ph airpods" href="/Shop"><svg class="i hr"><use href="#i-heart"/></svg></a><small class="br">APPLE</small><b>AirPods Pro 2</b><p class="sp">USB-C · Active noise cancellation<br><span class="st">★</span> 4.9 (318)</p><h3 class="pr">$199.00</h3><span class="tg">In stock</span><a class="bx" href="/Shop">Add to Cart</a></div><div class="pc" data-k="printer"><a class="ph printer" href="/Shop"><svg class="i hr"><use href="#i-heart"/></svg></a><small class="br">HP</small><b>HP LaserJet Pro M404dn</b><p class="sp">Mono laser · 38 ppm · Duplex · Ethernet<br><span class="st">★</span> 4.9 (63)</p><h3 class="pr">$249.00</h3><span class="tg">In stock</span><a class="bx" href="/Shop">Add to Cart</a></div></div><div data-v="profile" id="acc-prof"><h2>Profile &amp; addresses</h2><div class="cd"><h3>Contact details</h3><p class="m" data-p="who">Alex Morgan · Northstar Labs<br>alex.morgan@@northstarlabs.com<br>+1 (415) 555-0124</p><a class="bo" href="/Account/Settings">Edit profile</a></div><div class="cd" style="margin-top:16px"><h3>Delivery address</h3><p class="m">Northstar Labs<br>250 Market Street, Suite 400<br>San Francisco, CA 94105</p><span class="tg">Default</span></div><div class="cd" style="margin-top:16px"><h3>Billing address</h3><p class="m">Northstar Labs · Accounts Payable<br>250 Market Street, Suite 400<br>San Francisco, CA 94105</p></div></div><div class="mint" data-v="overview orders wishlist profile"><h3>Need an invoice or a hand?</h3><p class="m">Our support team is here Monday–Friday, 9am–6pm. Your account specialist is Jamie Lee.</p><a class="bo" href="/Home/Support">Contact support <svg class="i "><use href="#i-chat"/></svg></a></div></div></div></section>

