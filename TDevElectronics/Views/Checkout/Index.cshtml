@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    ViewBag.Page = "checkout";
}

@* Giống template (checkout.html), 4 bước: 1 Địa chỉ + giao hàng, 2 Thanh toán (9 phương thức, QR), 3 Xác nhận, 4 Hoàn tất.
   app.js dựng form địa chỉ theo quốc gia, kiểm tra mã bưu chính, tính phí; cart-checkout.js gửi đơn lên CheckoutController.PlaceOrder.
   Danh sách 237 quốc gia, 34 tỉnh/thành và quy tắc mã bưu chính nằm ở Helpers/CountryData.cs. *@
<section class="pg " id="checkout"><p class="cr m">Home &nbsp;/&nbsp; Cart / Checkout</p><h1>A few details. Then you’re all set.</h1><p class="m"><span data-b="sub3">Secure checkout · 3 items · Free delivery</span></p><div class="steps"><a class="on">1 · Delivery</a><a>2 · Payment</a><a>3 · Review</a></div>
<div class="lay2" data-step="1"><div class="cd"><h3>1. Contact &amp; delivery</h3><div class="g2s"><label class="fld "><small>Full name *</small><input id="ad-n" autocomplete="name" value="Alex Morgan"><span class="fe"></span></label><label class="fld "><small>Company (optional)</small><input id="ad-co" autocomplete="organization" value="Northstar Labs"></label><label class="fld "><small>Email *</small><input id="ad-e" type="email" autocomplete="email" value="alex.morgan@@northstarlabs.com"><span class="fe"></span></label><label class="fld "><small>Phone *</small><input id="ad-ph" type="tel" placeholder="0912 345 678" autocomplete="tel" value=""><span class="fe"></span></label></div><div id="addr" class="addr"></div><label class="ck"><input type="checkbox" checked>Billing address is the same as delivery</label><div class="mint"><b class="gr">Standard delivery · Free</b><p class="m">October 12–13 · Tracked, carbon-conscious shipping</p></div><a class="bt" asp-controller="Checkout" asp-action="Index" data-go="2">Continue to Payment <svg class="i "><use href="#i-arrow"/></svg></a></div>
<aside class="cd sum"><h3>Order summary</h3><span class="tg" data-b="tag">Free shipping unlocked</span><p class="sl"><span class="m" data-b="items">Subtotal · 3 items</span><b data-b="sub">$1,427.00</b></p><p class="sl"><span class="m">Shipping</span><b data-b="ship">Free</b></p><p class="sl"><span class="m">Tax (8%)</span><b data-b="tax">$114.16</b></p><p class="sl" style="display:none"><span class="m">Payment fee</span><b data-b="fee">$0.00</b></p><hr><p class="sl"><b>Total</b><b class="tot" data-b="due">$1,541.16</b></p><a class="bt wd" asp-controller="Checkout" asp-action="Index" data-go="2">Continue to Payment →</a></aside></div>
<div class="lay2" data-step="2"><div class="state"><small class="pc2">VISIBLE STATE / STEP 2 · PAYMENT</small><div class="cd"><h3>2. Choose how to pay</h3><div class="pm" role="radiogroup" aria-label="Payment method"><p class="pg-h">CARDS &amp; DIGITAL WALLETS</p><div class="g2s"><div class="opt on"><label class="ck"><input type="radio" name="pay" data-m="card" checked>Credit / debit card</label><small class="m">Visa · Mastercard · American Express</small><br><span class="tg ">Instant</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="paypal">PayPal</label><small class="m">Pay with your PayPal balance or linked bank</small><br><span class="tg b">Buyer protection</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="apple">Apple Pay</label><small class="m">Confirm with Face ID or Touch ID</small><br><span class="tg b">One tap</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="google">Google Pay</label><small class="m">Use cards saved to your Google account</small><br><span class="tg b">One tap</span></div></div><p class="pg-h">BANK &amp; QR</p><div class="g2s"><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="qr">Pay by QR code</label><small class="m">Scan with your banking or e-wallet app</small><br><span class="tg b">Instant · No card needed</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="bank">Bank transfer</label><small class="m">Invoice provided · For business orders</small><br><span class="tg a">Business</span></div></div><p class="pg-h">PAY LATER &amp; ON DELIVERY</p><div class="g2s"><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="bnpl">Pay in 4 installments</label><small class="m">Split into 4 payments every 2 weeks</small><br><span class="tg b">0% interest</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="net30">Net 30 invoice</label><small class="m">Pay 30 days after delivery · Purchase order accepted</small><br><span class="tg a">Business · Credit approval</span></div><div class="opt"><label class="ck"><input type="radio" name="pay" data-m="cod">Pay on delivery</label><small class="m">Pay the courier by card or cash when it arrives</small></div></div></div><div class="pd" data-m="card"><label class="fld "><small>Cardholder name *</small><input id="ch" autocomplete="cc-name" value="Alex Morgan"><span class="fe"></span></label><label class="fld "><small>Card number * <span class="tg b" id="cbr" style="display:none"></span></small><input id="cn" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" value="4242 4242 4242 4242"><span class="fe"></span></label><div class="g2s"><label class="fld "><small>Expiry date *</small><input id="ce" inputmode="numeric" autocomplete="cc-exp" placeholder="MM / YY" maxlength="7" value="08 / 28"><span class="fe"></span></label><label class="fld "><small>Security code *</small><input id="cc" inputmode="numeric" autocomplete="cc-csc" placeholder="CVC" maxlength="4" value="123"><span class="fe"></span></label></div><label class="ck"><input type="checkbox">Save this card securely for next time</label></div><div class="pd" data-m="paypal" style="display:none"><div class="mint"><b class="gr">You’ll continue in PayPal</b><p class="m">After you review your order, we’ll open a secure PayPal window to approve the payment. No card details are shared with TDev.</p></div><label class="fld "><small>PayPal email *</small><input id="ppm" type="email" value="alex.morgan@@northstarlabs.com"><span class="fe"></span></label></div><div class="pd" data-m="apple" style="display:none"><div class="mint"><b class="gr">Pay with Apple Pay</b><p class="m">Available on Safari, iPhone, iPad and Mac. You’ll confirm the payment on your device when you place the order.</p></div></div><div class="pd" data-m="google" style="display:none"><div class="mint"><b class="gr">Pay with Google Pay</b><p class="m">Available on Chrome and Android. You’ll pick a saved card and confirm when you place the order.</p></div></div><div class="pd" data-m="bank" style="display:none"><div class="mint"><b class="gr">Pay by bank transfer</b><p class="m">We’ll email an invoice with our bank details right after you place the order. Your order ships once the payment arrives (usually 1–2 business days).</p></div><dl class="sp2"><dt>Account name</dt><dd>TDev Electronics Inc.</dd><dt>Payment reference</dt><dd>TD-1048</dd><dt>Pay within</dt><dd>5 days</dd></dl></div><div class="pd" data-m="net30" style="display:none"><div class="mint"><b class="gr">Net 30 for business accounts</b><p class="m">Receive your order now and pay within 30 days of delivery. Subject to credit approval for Northstar Labs.</p></div><div class="g2s"><label class="fld "><small>Company name *</small><input id="n3c" value="Northstar Labs"><span class="fe"></span></label><label class="fld "><small>Purchase order number</small><input value="NSL-PO-2026-1008"></label></div><label class="fld "><small>Accounts payable email *</small><input id="n3e" type="email" value="ap@@northstarlabs.com"><span class="fe"></span></label></div><div class="pd" data-m="bnpl" style="display:none"><div class="mint"><b class="gr">4 payments · 0% interest</b><p class="m">Pay a quarter today and the rest every 2 weeks. No fees when you pay on time.</p></div><div class="tw"><table id="inst"><tr><th>Payment</th><th>When</th><th>Amount</th></tr></table></div></div><div class="pd" data-m="qr" style="display:none"><div class="qrp"><div class="qrb"><div id="qrbox" role="img" aria-label="Payment QR code"></div></div><div class="qri"><h3>Scan to pay</h3><p class="m">Open your banking or e-wallet app, choose <b>Scan QR</b>, then point your camera at the code.</p><p class="sl"><span class="m">Amount</span><b class="tot" id="qra">$0.00</b></p><p class="sl"><span class="m">Reference</span><b>TD-1048</b></p><p class="sl"><span class="m">Code expires in</span><b id="qrt">10:00</b></p><a class="bo" id="qrr">Refresh QR code</a><p class="m"><small>Works with most banking and e-wallet apps. We’ll confirm your payment automatically, then you can review your order.</small></p></div></div></div><div class="pd" data-m="cod" style="display:none"><div class="mint"><b class="gr">Pay when it arrives</b><p class="m">Pay the courier by card or cash on delivery. A $5.00 handling fee is added to your total. Not available for bulk or business orders.</p></div></div><a class="bt" asp-controller="Checkout" asp-action="Index" data-go="3">Continue to Review <svg class="i "><use href="#i-arrow"/></svg></a><p class="secn"><svg class="i"><use href="#i-shield"/></svg>Payments are encrypted. TDev never stores your full card number.</p></div></div>

<aside class="cd sum"><h3>Order summary</h3><span class="tg" data-b="tag">Free shipping unlocked</span><p class="sl"><span class="m" data-b="items">Subtotal · 3 items</span><b data-b="sub">$1,427.00</b></p><p class="sl"><span class="m">Shipping</span><b data-b="ship">Free</b></p><p class="sl"><span class="m">Tax (8%)</span><b data-b="tax">$114.16</b></p><p class="sl" style="display:none"><span class="m">Payment fee</span><b data-b="fee">$0.00</b></p><hr><p class="sl"><b>Total</b><b class="tot" data-b="due">$1,541.16</b></p><p class="secn"><svg class="i"><use href="#i-shield"/></svg>Secure, encrypted checkout</p></aside></div>
<div class="lay2" data-step="3"><div class="state"><small class="pc2">VISIBLE STATE / STEP 3 · REVIEW</small><div class="cd"><h3>3. Everything look right?</h3><div class="g2s"><div class="cd ln"><h3>Deliver to</h3><p class="m">Alex Morgan · Northstar Labs<br>250 Market Street, Suite 400<br>San Francisco, CA 94105</p><a class="bo" data-go="1">Edit delivery</a></div><div class="cd ln"><h3>Pay with</h3><p class="m" id="pwith">Visa ending 4242 · Alex Morgan</p><label class="fld "><small>Purchase order reference (optional)</small><input value="NSL-PO-2026-1008"></label></div></div><div class="tw"><table><tr><th>Product</th><th>Quantity</th><th>Price</th></tr><tr class="hl"><td><b>MacBook Air M4</b></td><td>1</td><td>$1,099.00</td></tr><tr><td><b>Sony WH-1000XM5</b></td><td>1</td><td>$249.00</td></tr><tr><td><b>Anker 565 USB-C Hub</b></td><td>1</td><td>$79.00</td></tr></table></div><p class="sl"><b>Total · Includes tax</b><b class="tot" data-b="due">$1,541.16</b></p><label class="ck"><input type="checkbox" checked>I agree to the Terms of Service and Return Policy.</label><a class="bt" asp-controller="Checkout" asp-action="Index" data-go="4" data-b="place">Place Order · $1,541.16</a><p class="secn"><svg class="i"><use href="#i-shield"/></svg>You won’t be charged until you place the order.</p></div></div>

<aside class="cd sum"><h3>Order summary</h3><span class="tg" data-b="tag">Free shipping unlocked</span><p class="sl"><span class="m" data-b="items">Subtotal · 3 items</span><b data-b="sub">$1,427.00</b></p><p class="sl"><span class="m">Shipping</span><b data-b="ship">Free</b></p><p class="sl"><span class="m">Tax (8%)</span><b data-b="tax">$114.16</b></p><p class="sl" style="display:none"><span class="m">Payment fee</span><b data-b="fee">$0.00</b></p><hr><p class="sl"><b>Total</b><b class="tot" data-b="due">$1,541.16</b></p><p class="secn"><svg class="i"><use href="#i-shield"/></svg>Secure, encrypted checkout</p></aside></div>
<div class="state mintbg" data-step="4"><small class="pc2">VISIBLE STATE / CONFIRMATION</small><div class="cd conf"><svg class="i big2"><use href="#i-check"/></svg><div class="x"><h2>Nice choice, Alex. Your order is in!</h2><p class="gr" data-b="conf">TD-1048 · $1,541.16 · Processing · Arrives Oct 12–13</p><p class="m" id="cfx" style="margin:8px 0"></p><small class="m">Confirmation and invoice sent to alex.morgan@@northstarlabs.com.</small></div><a class="bt" asp-controller="Account" asp-action="Index">View my orders</a></div></div></section>

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

@* Token chống giả mạo yêu cầu: cart-checkout.js đọc và gửi kèm khi POST /Checkout/PlaceOrder *@
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/cart-checkout.js" asp-append-version="true"></script>
}
