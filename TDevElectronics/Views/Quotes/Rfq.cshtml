@{
    ViewData["Title"] = "Request a Quote";
    ViewBag.Page = "rfq";
}

@* Giống template (rfq.html). app.js (rfq / data-act="rfq") tự tính ước tính, kiểm tra trường bắt buộc và gửi yêu cầu *@
<section class="pg " id="rfq"><p class="cr m">Home &nbsp;/&nbsp; Business / Request a quote</p><h1>Your team’s next chapter starts here.</h1><p class="m">Tell us what you need. We’ll send a tailored quote within one business day.</p><div class="lay2"><div><div class="cd"><h3>1. Company &amp; contact</h3><div class="g2s"><label class="fld "><small>Company name *</small><input autocomplete="organization" value="Northstar Labs"></label><label class="fld "><small>Contact name *</small><input autocomplete="name" value="Alex Morgan"></label><label class="fld "><small>Business email *</small><input type="email" inputmode="email" autocomplete="email" value="alex.morgan@@northstarlabs.com"></label><label class="fld "><small>Phone *</small><input type="tel" inputmode="tel" autocomplete="tel" value="+1 (415) 555-0124"></label></div><label class="fld "><small>Company tax ID (optional)</small><input value="US-94-3812046"></label></div><div class="cd"><h3>2. Products &amp; quantities</h3><div class="tw"><table><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Est. unit price</th></tr><tr class="hl"><td><b>MacBook Air M4</b></td><td>LAP-M4</td><td>25</td><td>$999.00</td></tr><tr><td><b>Anker 565 USB-C Hub</b></td><td>ACC-HUB</td><td>25</td><td>$69.00</td></tr></table></div><div class="g2s"><label class="fld "><small>MacBook Air quantity</small><input type="number" inputmode="numeric" min="0" value="25"></label><label class="fld "><small>USB-C Hub quantity</small><input type="number" inputmode="numeric" min="0" value="25"></label></div><a class="bo" asp-controller="Shop" asp-action="Index">Add product <svg class="i "><use href="#i-plus"/></svg></a><p class="m"><small>Can’t find a device? Add it to your notes and we’ll source it for you.</small></p></div><div class="cd"><h3>3. Project details</h3><div class="g2s"><label class="fld "><small>Target delivery date *</small><input value="26 Oct 2026"></label><label class="fld "><small>Budget (before tax)</small><input value="$27,000.00"></label></div><label class="fld "><small>Project name *</small><input value="25-device rollout"></label><label class="fld "><small>Delivery address</small><input autocomplete="street-address" value="250 Market Street, Suite 400, San Francisco, CA 94105"></label><label class="fld "><small>Project notes</small><input value="25 MacBook Air M4 laptops and USB-C hubs for our new engineering team."></label><div class="drop">Drop a specification or purchase list here · PDF, XLSX · Up to 10MB</div></div><label class="ck"><input type="checkbox" checked>I agree to be contacted about this request and accept the Privacy Policy.</label><a class="bt" asp-controller="Quotes" asp-action="Index" data-act="rfq">Submit Request <svg class="i "><use href="#i-arrow"/></svg></a> <a class="bo" data-draft="1">Save draft</a></div>
<div class="stk">
<aside class="cd sum"><h3>Your estimate</h3><span class="tg">Bulk pricing applied</span><p class="m"><small data-r="lines">25 × MacBook Air M4 · $999.00 / unit<br>25 × Anker 565 USB-C Hub · $69.00 / unit</small></p><p class="sl"><span class="m" data-r="units">Subtotal · 50 units</span><b data-r="sub">$26,700.00</b></p><p class="sl"><span class="m">Shipping</span><b>Free</b></p><p class="sl"><span class="m">Tax (8%)</span><b data-r="tax">$2,136.00</b></p><hr><p class="sl"><b>Estimated total</b><b class="tot" data-r="total">$28,836.00</b></p><a class="bt wd" asp-controller="Quotes" asp-action="Index" data-act="rfq">Submit Request <svg class="i "><use href="#i-arrow"/></svg></a><small class="m">Indicative pricing, not a final quote.</small></aside><div class="mint"><h3>A real person. On your side.</h3><p class="m">Jamie Lee and our business team will check your list, confirm stock and prepare a no-obligation proposal.</p><small class="gr">Response within 1 business day</small></div></div></div></section>
